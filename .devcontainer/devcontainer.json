{
  "name": "modern-resume-theme (Jekyll)",
  "image": "mcr.microsoft.com/devcontainers/jekyll:2-bullseye",
  "postCreateCommand": "sudo chown -R $(whoami) /usr/local/bundle && bundle install",
  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": {
      "label": "Jekyll Site",
      "onAutoForward": "openPreview"
    }
  }
}
